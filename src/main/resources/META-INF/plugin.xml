<idea-plugin>
    <!-- Plugin name and description -->
    <name>Easy Tools</name>
    <id>io.github.easy.tools</id>
    <version>1.0.1</version>

    <!-- Vendor information -->
    <vendor email="iamxiaohaijun@gmail.com" url="https://github.com/easy-tools">Easy Tools</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
      <h2>Easy Tools - IntelliJ IDEA Productivity Plugin</h2>
      <p>A comprehensive productivity plugin for Java developers that enhances development experience with JavaDoc generation, API management, and MyBatis enhancement.</p>

      <h3>Core Features</h3>
      <ul>
        <li><b>JavaDoc Generation:</b> Template-based comment generation for files, classes, methods, and fields (Alt+Shift+J, Alt+J)</li>
        <li><b>API Management:</b> Spring MVC REST API scanner with tree view, search dialog (Ctrl+\), and navigation features</li>
        <li><b>MyBatis Enhancement:</b> Smart navigation between Mapper and XML, parameter completion with #{} support, reference jumping, and SQL tag generation</li>
        <li><b>Development Tools:</b> Naming convention converter (Ctrl+Shift+U) and project view JavaDoc decorator</li>
      </ul>

      <h3>Key Highlights</h3>
      <ul>
        <li>Bidirectional navigation between Mapper interfaces and XML files</li>
        <li>Intelligent parameter completion with @Param and nested object support</li>
        <li>Swagger/OpenAPI annotation integration (@Operation, @Tag, @Schema)</li>
        <li>Customizable Velocity templates for JavaDoc generation</li>
        <li>Feature toggle system with configurable switches</li>
        <li>Syntax highlighting for MyBatis XML tags</li>
      </ul>

      <h3>Configuration</h3>
      <p>Settings → Other Settings → Easy Config</p>
      <ul>
        <li>Feature Toggles: Enable/disable specific modules</li>
        <li>JavaDoc Config: Customize comment templates</li>
      </ul>

      <h3>Quick Start</h3>
      <ul>
        <li><b>Alt+Shift+J:</b> Generate file comment</li>
        <li><b>Alt+J:</b> Generate element comment</li>
        <li><b>Ctrl+\:</b> Quick API search</li>
        <li><b>Ctrl+Shift+U:</b> Convert property naming</li>
      </ul>
    ]]></description>

    <!-- Product and plugin compatibility requirements. -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <!-- 可选依赖 Database 插件(Ultimate): Mapper XML 的 SQL 语言注入(表/列补全与检测)与运行 SQL 方言解析。
         Community 环境下不加载，核心功能自动降级为 SQL 关键字补全与剪贴板复制。 -->
    <depends optional="true" config-file="easy-tools-database.xml">com.intellij.database</depends>

    <!-- 自定义扩展点 -->
    <extensionPoints>
        <!-- Mapper XML 的 SQL 方言解析器(由可选数据源模块实现) -->
        <extensionPoint qualifiedName="io.github.easy.tools.mybatis.sqlDialectResolver"
                        interface="io.github.easy.tools.service.mybatis.sql.MyBatisSqlDialectResolver"
                        dynamic="true"/>
    </extensionPoints>

    <!-- Extension points -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- 注册项目视图节点装饰器，用于在文件列表中显示注释 -->
        <projectViewNodeDecorator implementation="io.github.easy.tools.comment.FileCommentDecorator"/>

        <!-- 注册MyBatis Mapper接口的行标记提供者，用于显示导航图标 -->
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="io.github.easy.tools.ui.mybatis.MapperLineMarkerProvider"/>

        <!-- 注册MyBatis XML SQL标签的行标记提供者，用于从 XML 跳转到 Mapper 接口方法 -->
        <codeInsight.lineMarkerProvider language="XML"
                                        implementationClass="io.github.easy.tools.ui.mybatis.XmlSqlTagLineMarkerProvider"/>

        <!-- 注册Mapper XML语句运行行标记，点击组装完整SQL并生成SQL控制台临时文件/复制到剪贴板 -->
        <codeInsight.lineMarkerProvider language="XML"
                                        implementationClass="io.github.easy.tools.ui.mybatis.RunSqlLineMarkerProvider"/>

        <!-- 注册Mapper XML文件专属图标提供者 -->
        <iconProvider implementation="io.github.easy.tools.ui.mybatis.MapperXmlIconProvider"/>

        <!-- 注册MyBatis Live Templates(5组模板) -->
        <defaultLiveTemplatesProvider
                implementation="io.github.easy.tools.service.mybatis.template.MyBatisLiveTemplatesProvider"/>

        <!-- 注册MyBatis XML文件注解器，用于语法高亮 -->
        <annotator language="XML"
                   implementationClass="io.github.easy.tools.ui.mybatis.MyBatisXmlAnnotator"/>

        <!-- 注册MyBatis XML参数引用贡献者，用于参数到Java字段的引用跳转 -->
        <psi.referenceContributor language="XML"
                                  implementation="io.github.easy.tools.service.mybatis.MyBatisParamReferenceContributor"/>

        <!-- 注册 *Provider 注解引用贡献者: @SelectProvider method 属性 -> Provider类方法 跳转/补全 -->
        <psi.referenceContributor language="JAVA"
                                  implementation="io.github.easy.tools.service.mybatis.MyBatisProviderReferenceContributor"/>

        <!-- MyBatis-Plus QueryWrapper 条件列名补全(按包装器泛型实体的数据库列) -->
        <completion.contributor language="JAVA"
                                id="io.github.easy.tools.mybatis.plus.wrapper"
                                implementationClass="io.github.easy.tools.service.mybatis.completion.MyBatisPlusWrapperCompletionContributor"/>

        <!-- 注册MyBatis结构引用贡献者: namespace/id/resultMap/refid/类型属性 的跳转与补全 -->
        <psi.referenceContributor language="XML"
                                  implementation="io.github.easy.tools.service.mybatis.MyBatisMapperReferenceContributor"/>

        <!-- 注册Mapper方法名引用贡献者: 接口方法名 -> XML语句id 的跳转(Ctrl+B/Find Usages/重命名同步) -->
        <psi.referenceContributor language="JAVA"
                                  implementation="io.github.easy.tools.service.mybatis.MyBatisMapperMethodReferenceContributor"/>

        <!-- MyBatis一致性检测 -->
        <localInspection language="XML"
                         shortName="MyBatisNamespace"
                         displayName="MyBatis namespace"
                         groupName="MyBatis"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="io.github.easy.tools.ui.mybatis.inspection.MyBatisNamespaceInspection"/>
        <localInspection language="XML"
                         shortName="MyBatisStatementId"
                         displayName="MyBatis statement id"
                         groupName="MyBatis"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="io.github.easy.tools.ui.mybatis.inspection.MyBatisStatementIdInspection"/>
        <localInspection language="JAVA"
                         shortName="MyBatisMethodNotInXml"
                         displayName="Mapper method without SQL statement"
                         groupName="MyBatis"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="io.github.easy.tools.ui.mybatis.inspection.MyBatisMethodNotInXmlInspection"/>
        <localInspection language="XML"
                         shortName="MyBatisResultMap"
                         displayName="MyBatis resultMap mapping"
                         groupName="MyBatis"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="io.github.easy.tools.ui.mybatis.inspection.MyBatisResultMapInspection"/>
        <localInspection language="XML"
                         shortName="MyBatisParam"
                         displayName="MyBatis #{} parameter"
                         groupName="MyBatis"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="io.github.easy.tools.ui.mybatis.inspection.MyBatisParamInspection"/>
        <localInspection language="XML"
                         shortName="MyBatisOgnl"
                         displayName="MyBatis OGNL expression"
                         groupName="MyBatis"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="io.github.easy.tools.ui.mybatis.inspection.MyBatisOgnlInspection"/>
        <!-- Mapper 未使用方法检测(方法在Java侧无任何调用方) -->
        <localInspection language="JAVA"
                         shortName="MyBatisUnusedMapperMethod"
                         displayName="Unused mapper method"
                         groupName="MyBatis"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="io.github.easy.tools.ui.mybatis.inspection.MyBatisUnusedMapperMethodInspection"/>
        <!-- resultType 与方法返回值匹配检测 -->
        <localInspection language="XML"
                         shortName="MyBatisResultType"
                         displayName="MyBatis resultType mismatch"
                         groupName="MyBatis"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="io.github.easy.tools.ui.mybatis.inspection.MyBatisResultTypeInspection"/>

        <!-- 注册MyBatis XML代码补全贡献者,用于参数智能提示 -->
        <!-- 不指定language以支持语言注入场景(如XML中的SQL注入为MySQL) -->
        <completion.contributor language="any"
                                order="first"
                                id="io.github.easy.tools.mybatis.completion"
                                implementationClass="io.github.easy.tools.service.mybatis.MyBatisXmlCompletionContributor"/>

        <!-- 注册MyBatis意图操作，用于Ctrl+回车菜单 -->
        <intentionAction>
            <className>io.github.easy.tools.intention.MyBatisSelectIntention</className>
            <category>MyBatis</category>
        </intentionAction>
        <intentionAction>
            <className>io.github.easy.tools.intention.MyBatisInsertIntention</className>
            <category>MyBatis</category>
        </intentionAction>
        <intentionAction>
            <className>io.github.easy.tools.intention.MyBatisUpdateIntention</className>
            <category>MyBatis</category>
        </intentionAction>
        <intentionAction>
            <className>io.github.easy.tools.intention.MyBatisDeleteIntention</className>
            <category>MyBatis</category>
        </intentionAction>

        <!-- 一键为Mapper方法所有参数添加@Param注解 -->
        <intentionAction>
            <className>io.github.easy.tools.intention.AddParamAnnotationIntention</className>
            <category>MyBatis</category>
        </intentionAction>

        <!-- 迁移注解SQL(@Select等)到Mapper XML语句标签 -->
        <intentionAction>
            <className>io.github.easy.tools.intention.MigrateSqlAnnotationIntention</className>
            <category>MyBatis</category>
        </intentionAction>

        <!-- MyBatis OGNL 独立语言: 注入到 if/when test 属性，提供高亮/括号匹配 -->
        <lang.parserDefinition language="MyBatisOgnl"
                               implementationClass="io.github.easy.tools.lang.ognl.MyBatisOgnlParserDefinition"/>
        <lang.syntaxHighlighterFactory language="MyBatisOgnl"
                                       implementationClass="io.github.easy.tools.lang.ognl.MyBatisOgnlSyntaxHighlighterFactory"/>
        <lang.braceMatcher language="MyBatisOgnl"
                           implementationClass="io.github.easy.tools.lang.ognl.MyBatisOgnlBraceMatcher"/>
        <multiHostInjector implementation="io.github.easy.tools.lang.ognl.MyBatisOgnlMultiHostInjector"/>

        <!-- Mapper XML 代码折叠(长语句/长SQL文本折叠) -->
        <lang.foldingBuilder language="XML"
                             implementationClass="io.github.easy.tools.ui.mybatis.folding.MapperXmlFoldingBuilder"/>

        <!-- Mapper XML 格式化: 保持 SQL 文本排版与动态标签缩进，非 Mapper XML 委托平台默认格式化器 -->
        <lang.formatter language="XML" order="first"
                        implementationClass="io.github.easy.tools.service.mybatis.format.MyBatisXmlFormattingModelBuilder"/>

        <!-- Mapper XML inspection 抑制(SQL方言/数据源类噪音告警 + OGNL/SQL文本拼写检查) -->
        <lang.inspectionSuppressor language="XML"
                                   implementationClass="io.github.easy.tools.ui.mybatis.suppress.MapperXmlInspectionSuppressor"/>

        <!-- Mapper Spring 注入报错抑制: Mapper接口注入点(@Autowired/@Resource)不报 "Could not autowire"，
             与 Ultimate Spring 插件原生 MyBatis 支持互补，识别 @Mapper/@MapperScan/框架BaseMapper -->
        <lang.inspectionSuppressor language="JAVA"
                                   implementationClass="io.github.easy.tools.ui.mybatis.suppress.MapperSpringInjectionSuppressor"/>
    </extensions>

    <!-- Plugin metadata -->
    <change-notes><![CDATA[
    <h3>v1.2.0 - Java 侧 Mapper 增强（迁移自 MyBatisCodeHelper-Pro 清单 #14/#16/#17/#18/#20/#21）</h3>
    <h4>新增功能:</h4>
    <ul>
      <li>一键为 Mapper 方法所有参数添加 @Param 注解（意图操作）</li>
      <li>Mapper 未使用方法检测（Java 侧无调用方即告警，XML 语句关联不算使用）</li>
      <li>resultType 与方法返回值匹配检测 + select 缺少 resultMap/resultType 检测</li>
      <li>Spring 集成：识别 @MapperScan/@MapperScans 扫描包（含 basePackageClasses/annotationClass/markerInterface），Mapper 注入点不再报 "Could not autowire"</li>
      <li>MyBatis-Plus / MyBatis-Flex / tk-mapper 兼容：BaseMapper 体系接口免注解识别、框架方法豁免"缺SQL"检测、XML id 补全过滤框架方法、QueryWrapper 条件列名补全（@TableField/@TableId 感知）</li>
      <li>@SelectProvider 等 method 属性跳转/补全/重命名同步；注解 SQL（@Select 等）一键迁移到 Mapper XML（支持 script 动态 SQL、自动创建 XML、select 自动带 resultType）</li>
    </ul>

    <h3>v1.1.0 - MyBatis SQL 编辑体验（迁移自 MyBatisCodeHelper-Pro 清单 #1-11）</h3>
    <h4>新增功能:</h4>
    <ul>
      <li>SQL 关键字补全；Ultimate 下可选数据源模块向语句注入 SQL 语言（表/列补全与检查）</li>
      <li>resultMap property 属性补全/跳转/重命名 + 未解析与重复列检测</li>
      <li>MyBatis OGNL 独立语言：test 属性高亮、括号匹配、字符串比较误用检测（含快速修复）</li>
      <li>#{param, jdbcType=...} 占位符属性补全 + 参数未定义/jdbcType 非法检测</li>
      <li>Mapper XML 保守格式化（保持 SQL 排版与动态标签缩进）</li>
      <li>语句/长 SQL 文本代码折叠</li>
      <li>5 组 Live Templates（SQL 语句/注释/动态标签/OGNL/占位符）</li>
      <li>语句行标记一键组装完整 SQL（生成 SQL 控制台临时文件并复制）</li>
      <li>Ctrl+Alt+C 提取 SQL 片段为 sql+include</li>
      <li>Mapper XML 文件专属图标</li>
      <li>抑制 SQL 方言/数据源噪音告警与 OGNL/SQL 文本拼写检查</li>
    </ul>

    <h3>v1.0.0 - 最新更新</h3>
    <h4>新增功能:</h4>
    <ul>
      <li>项目视图注释显示功能</li>
      <li>在项目树中显示 JavaDoc 注释</li>
      <li>显示目录的 package-info.java 描述</li>
      <li>显示 Java 文件的类描述</li>
      <li>自动提取和显示注释</li>
      <li>线程安全的 PSI 元素访问</li>
    </ul>

    <h4>历史更新:</h4>
    <ul>
      <li>IDEA 右侧边栏的 API 接口管理面板</li>
      <li>Spring MVC 注解支持 (@RestController、@Controller、@RequestMapping 等)</li>
      <li>元注解的递归处理</li>
      <li>支持 Swagger/OpenAPI 注解 (@Operation、@Tag 等)</li>
      <li>从 Swagger/OpenAPI 注解中提取 Controller 描述</li>
      <li>在树形结构视图中按 Controller 分组 API</li>
      <li>修复 API 路径参数显示问题(缺少右括号)</li>
      <li>修复树形视图中的双击导航问题</li>
      <li>通过移除 PSI 元素序列化修复插件启动和导航问题</li>
      <li>修复树节点对象处理以实现正确导航</li>
      <li>修复自定义树节点实现以正确存储和检索 API 信息</li>
      <li>修复处理循环注解引用时的无限递归问题</li>
      <li>修复访问 PSI 元素时的线程安全问题</li>
      <li>实现带实时 UI 更新的增量扫描</li>
      <li>双击导航到对应的 Java 方法</li>
    </ul>
    ]]></change-notes>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="io.github.easy.tools.ui.config.FeatureToggleService"/>
        <applicationService serviceImplementation="io.github.easy.tools.ui.config.DocConfigService"/>
        <applicationConfigurable
                parentId="other"
                instance="io.github.easy.tools.ui.config.EasyConfig"
                id="io.github.easy.tools.ui.config.EasyConfig"
                displayName="Easy Config">
            <configurable instance="io.github.easy.tools.ui.config.FeatureToggleConfig"
                          id="io.github.easy.tools.ui.config.EasyConfig.01.FeatureToggle"
                          displayName="功能开关"
                          groupWeight="40"/>
        </applicationConfigurable>
        <!-- Java注释配置改为项目级别配置 -->
        <projectConfigurable parentId="io.github.easy.tools.ui.config.EasyConfig"
                             instance="io.github.easy.tools.ui.config.DocConfig"
                             id="io.github.easy.tools.ui.config.EasyConfig.03.DocConfig"
                             displayName="Java注释配置"
                             groupWeight="20"/>
        <applicationService serviceImplementation="io.github.easy.tools.action.doc.listener.FileSaveListenerManager"/>
        <notificationGroup id="Easy Docs Notification Group"
                           displayType="BALLOON"
                           key="notification.group.name"/>
    </extensions>


    <applicationListeners>
        <listener class="io.github.easy.tools.action.doc.listener.FileSaveListenerManager"
                  topic="com.intellij.ide.AppLifecycleListener"/>
        <listener class="io.github.easy.tools.action.doc.listener.FileCreationListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </applicationListeners>

    <!-- 项目启动活动 -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- MyBatis Mapper XML文件扫描和监听 -->
        <postStartupActivity implementation="io.github.easy.tools.listener.MapperXmlStartupActivity"/>
    </extensions>

    <actions>
        <group id="JavaDocMenus" popup="true" description="Java Doc" text="Java Doc">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <action id="GenerateFileCommentAction"
                    class="io.github.easy.tools.action.doc.actions.GenerateFileCommentAction"
                    text="当前文件生成注释"
                    description="当前文件生成注释">
                <keyboard-shortcut keymap="$default" first-keystroke="alt shift J"/>
            </action>
            <action id="GenerateElementCommentAction"
                    class="io.github.easy.tools.action.doc.actions.GenerateElementCommentAction"
                    text="当前元素生成注释"
                    description="当前元素生成注释">
                <keyboard-shortcut keymap="$default" first-keystroke="alt J"/>
            </action>
            <action id="RemoveElementCommentsAction"
                    class="io.github.easy.tools.action.doc.actions.RemoveElementCommentsAction"
                    text="删除当前元素注释"
                    description="删除当前元素注释"/>
            <action id="RemoveFileCommentsAction"
                    class="io.github.easy.tools.action.doc.actions.RemoveFileCommentsAction"
                    text="删除当前文件注释"
                    description="删除当前文件注释"/>
        </group>

        <group id="MyBatisActionGroup" text="MyBatis Action" description="MyBatis SQL Tag Generation" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="JavaDocMenus"/>
            <action id="CreateSelectTagAction"
                    class="io.github.easy.tools.action.mybatis.CreateSelectTagAction"
                    text="创建Select方法"
                    description="在XML中为选中的Mapper方法创建select标签"/>
            <action id="CreateInsertTagAction"
                    class="io.github.easy.tools.action.mybatis.CreateInsertTagAction"
                    text="创建Insert方法"
                    description="在XML中为选中的Mapper方法创建insert标签"/>
            <action id="CreateUpdateTagAction"
                    class="io.github.easy.tools.action.mybatis.CreateUpdateTagAction"
                    text="创建Update方法"
                    description="在XML中为选中的Mapper方法创建update标签"/>
            <action id="CreateDeleteTagAction"
                    class="io.github.easy.tools.action.mybatis.CreateDeleteTagAction"
                    text="创建Delete方法"
                    description="在XML中为选中的Mapper方法创建delete标签"/>
            <action id="ExtractSqlFragmentAction"
                    class="io.github.easy.tools.action.mybatis.ExtractSqlFragmentAction"
                    text="提取SQL片段"
                    description="将选中的SQL文本提取为sql片段并用include引用">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt C"/>
            </action>
        </group>

        <group id="PropertyConversionGroup" text="属性转换" description="Property Conversion">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="MyBatisActionGroup"/>
            <action id="PropertyConversionAction"
                    class="io.github.easy.tools.action.conversion.PropertyConversionAction"
                    text="转换选中属性"
                    description="将选中的属性名转换为不同格式">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift U"/>
            </action>
        </group>

        <!-- API搜索动作 -->
        <action id="ApiSearchAction"
                class="io.github.easy.tools.action.api.ApiSearchAction"
                text="API搜索"
                description="搜索并跳转到API接口">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl BACK_SLASH"/>
        </action>
    </actions>
</idea-plugin>
