<templateSet group="MyBatis-Comment">
    <template name="c." value="&lt;!-- $END$ --&gt;"
              description="XML 注释" toReformat="false" toShortenFQNames="true">
        <context>
            <option name="XML" value="true"/>
        </context>
    </template>
    <template name="sqlc" value="-- $END$"
              description="SQL 行注释(--)" toReformat="false" toShortenFQNames="true">
        <context>
            <option name="XML" value="true"/>
        </context>
    </template>
    <template name="sqlcb" value="/*&#10;    $END$&#10;*/"
              description="SQL 块注释(/* */)" toReformat="false" toShortenFQNames="true">
        <context>
            <option name="XML" value="true"/>
        </context>
    </template>
    <template name="todo" value="-- TODO $USER$ $DATE$ : $END$"
              description="SQL TODO 注释(带作者和日期)" toReformat="false" toShortenFQNames="true">
        <variable name="USER" expression="user()" defaultValue="" alwaysStopAt="false"/>
        <variable name="DATE" expression="date(&quot;yyyy-MM-dd&quot;)" defaultValue="" alwaysStopAt="false"/>
        <context>
            <option name="XML" value="true"/>
        </context>
    </template>
</templateSet>
