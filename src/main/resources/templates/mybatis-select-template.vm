<select id="${methodId}" resultType="${resultType}">
    SELECT
        *
    FROM
        ${tableName}
    <where>
#if($parameters && $parameters.size() > 0)
#foreach($param in $parameters)
        <if test="${param.shortName} != null">
            AND ${param.columnName} = #{${param.shortName}}
        </if>
#end
#end
    </where>
</select>